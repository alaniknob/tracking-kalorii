# Skopiuj do .env.local i uzupełnij. Plik .env.local NIE trafia do repozytorium.
#
# Etapy 1–6: aplikacja działa BEZ tych zmiennych (kalkulator, katalog, generator, lista zakupów
# w karcie przeglądarki). Etap 7 (konta i trwałość) wymaga projektu Supabase.
# Dokładne kroki: docs/KONFIGURACJA.md
# Wartości: Project Settings → API.

# Adres projektu Supabase (publiczny, trafia do przeglądarki).
NEXT_PUBLIC_SUPABASE_URL=

# Klucz publiczny: dawny „anon” (JWT, eyJ…) ALBO nowy „publishable” (sb_publishable_…).
# Oba wklejasz tutaj — to ten sam slot. Dostęp do danych ograniczają polityki RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Klucz „service_role” omija RLS — WYŁĄCZNIE po stronie serwera (.env.local / zmienne hostingu).
# Nigdy nie poprzedzaj go prefiksem NEXT_PUBLIC_ i nie używaj w komponentach klienckich.
# Potrzebny tylko gdy funkcja SQL delete_own_account nie jest w bazie (usuwanie konta).
# Obecnie opcjonalny — migracja etapu 7 dodaje delete_own_account().
SUPABASE_SERVICE_ROLE_KEY=

# Opcjonalnie: port serwera dla testów Playwright (domyślnie 3100).
# E2E_PORT=3100
