# Skopiuj do .env.local i uzupełnij. Plik .env.local NIE trafia do repozytorium.
#
# Etap 1–2: aplikacja działa BEZ tych zmiennych (kalkulator nie zapisuje danych).
# Etap 7 (konta i trwałość) wymaga projektu Supabase: https://supabase.com/dashboard
# Wartości znajdziesz w: Project Settings → API.

# Adres projektu Supabase (publiczny, trafia do przeglądarki).
NEXT_PUBLIC_SUPABASE_URL=

# Klucz publiczny „anon” / „publishable” (publiczny; dostęp do danych ograniczają polityki RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Klucz „service_role” omija RLS — WYŁĄCZNIE po stronie serwera (skrypty importu, migracje).
# Nigdy nie poprzedzaj go prefiksem NEXT_PUBLIC_ i nie używaj w komponentach klienckich.
# Obecnie nieużywany.
SUPABASE_SERVICE_ROLE_KEY=

# Opcjonalnie: port serwera dla testów Playwright (domyślnie 3100).
# E2E_PORT=3100
